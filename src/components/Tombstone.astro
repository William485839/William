---
// One deal, set as a formal announcement ("tombstone").
import { type Deal, roleLabel, formatValue } from '../data/deals';

interface Props {
  deal: Deal;
  size?: 'normal' | 'large';
}

const { deal, size = 'normal' } = Astro.props;
const value = formatValue(deal);
---

<article
  class:list={['tombstone', `is-${size}`]}
  data-role={deal.role}
  data-decade={Math.floor(deal.year / 10) * 10}
>
  <h3 class="t-client">{deal.client}</h3>
  <p class="t-text">{deal.text}</p>
  {value && <p class="t-value">{value}</p>}
  <p class="t-role">PK Partners: {roleLabel[deal.role].toLowerCase()}</p>
  <p class="t-year">{deal.year}{deal.pending && <span class="t-pending">, pending</span>}</p>
  {deal.confirm && <p class="t-confirm">Name to be confirmed</p>}
</article>

<style>
  .tombstone {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) 1.25rem;
    background: var(--card);
    text-align: center;
    min-height: 15rem;
  }
  .tombstone p { max-width: 30ch; }

  .t-year { font-weight: 700; color: var(--ink); }
  .t-pending { font-weight: 400; }
  .t-client {
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .t-text { color: var(--ink); line-height: 1.4; }
  .t-value {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .t-role {
    margin-top: 1.25rem;
    font-size: var(--step-small);
    font-style: italic;
    color: var(--ink-on-field);
  }
  .t-confirm {
    font-size: var(--step-small);
    color: var(--ink-on-field);
    font-style: italic;
  }

  .is-large { min-height: 20rem; }
  .is-large .t-client { font-size: var(--step-2); }
  @media (max-width: 34rem) {
    .tombstone { min-height: 0; padding-block: 1.5rem; }
  }
  .is-large .t-value { font-size: var(--step-2); }
</style>
