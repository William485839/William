---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Tombstone from '../components/Tombstone.astro';
import { deals } from '../data/deals';
import { team } from '../data/team';
import { offices, tel } from '../data/offices';

// The same order as the live site: intro, the four doors, about, team, a few deals, offices.
const recent = deals.filter((d) => !d.confirm).slice(0, 4);
const stockholm = offices[0];

const doors = [
  { href: '/where-we-are/', title: 'Bespoke service meets global reach.', text: 'Offices in Stockholm, Paris, Frankfurt and Milan.' },
  { href: '/what-we-do/', title: 'In case you need independent advice.', text: 'Sell-side, buy-side and capital raising.' },
  { href: '/who-we-are/', title: 'International teamwork instead of just a network.', text: `${team.length} people in Stockholm.` },
  { href: '/what-we-have-done/', title: 'Proven expertise in delivering value to our clients.', text: `${deals.length} deals since 2006.` },
];

const stats = [
  { n: '~60', label: 'transactions completed' },
  { n: '11', label: 'M&A professionals' },
  { n: '250+', label: 'SEKbn combined value' },
  { n: '2002', label: 'founded in Stockholm' },
];
---

<Base
  title="Home"
  description="PK Partners is a European partner-led investment banking advisory firm in Stockholm, advising on M&A and corporate finance since 2002 together with CASE CASSIOPEA."
>
  <section class="wrap hero" aria-labelledby="hero-title">
    <h1 id="hero-title">European partner-led investment banking advisory firm</h1>
    <div class="hero-side">
      <p class="lead">
        Independent M&amp;A and corporate finance advice from Stockholm since 2002, in cooperation with <strong>CASE CASSIOPEA</strong> in Paris, Frankfurt and Milan.
      </p>
      <div class="hero-actions">
        <a class="button" href={url('/contact-us/')}>Contact us</a>
        <a href={tel(stockholm.phone)}>{stockholm.phone}</a>
      </div>
    </div>
  </section>

  <nav class="wrap doors" aria-label="Find out more">
    {doors.map((d, i) => (
      <a class="door" href={url(d.href)}>
        <span class="door-n">0{i + 1}</span>
        <span class="door-title">{d.title}</span>
        <span class="door-text">{d.text}</span>
        <span class="door-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>

  <section class="section wrap about" aria-labelledby="about-title" data-reveal>
    <h2 id="about-title">About PK Partners</h2>
    <div class="about-body">
      <p class="statement">
        Our Stockholm office was founded in 2002 and is part of a strong European partnership through CASE CASSIOPEA.
      </p>
      <p>
        We offer our clients comprehensive industry expertise, the global network of an established banking group, and independent advice, to strategically develop and successfully execute M&amp;A and corporate finance transactions.
      </p>
    </div>
    <dl class="stats">
      {stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.n}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section wrap people" aria-labelledby="people-title">
    <div class="people-head" data-reveal>
      <h2 id="people-title">The people behind every deal</h2>
      <p>
        Senior partners have more than 25 years of experience each and work on the execution of every deal themselves.
      </p>
    </div>
    <ul class="roster" data-reveal>
      {team.map((p) => (
        <li><a href={url(`/who-we-are/${p.slug}/`)}>{p.name}</a></li>
      ))}
    </ul>
  </section>

  <section class="deals-field" aria-labelledby="deals-title">
    <div class="wrap">
      <div class="deals-head" data-reveal>
        <h2 id="deals-title">Recent deals</h2>
        <a href={url('/what-we-have-done/')}>See all {deals.length} deals</a>
      </div>
      <div class="deals" data-reveal>
        {recent.map((deal) => <Tombstone deal={deal} />)}
      </div>
    </div>
  </section>

  <section class="section wrap offices" aria-labelledby="offices-title" data-reveal>
    <h2 id="offices-title">Bespoke service meets global reach.</h2>
    <p class="offices-intro">
      Most of our transactions are cross-border. We focus on the Nordics and Northern Europe, with partners across Western Europe and the Americas.
    </p>
    <ul class="office-list">
      {offices.map((o) => (
        <li>
          <h3>{o.city}</h3>
          <p class="muted">{o.firm}</p>
        </li>
      ))}
    </ul>
    <p><a href={url('/where-we-are/')}>Our offices and partners</a></p>
  </section>
</Base>

<style>
  /* Hero: the company's own line, big and calm, the way the live site opens. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 2rem var(--gutter);
    align-items: end;
    padding-block: clamp(3.5rem, 2rem + 7vw, 9rem) clamp(2.5rem, 2rem + 3vw, 5rem);
  }
  .hero h1 {
    font-size: clamp(2.6rem, 1.2rem + 5.2vw, 6.5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 14ch;
  }
  .hero-side { display: grid; gap: 1.75rem; }
  .hero-side strong { font-weight: 700; color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; font-weight: 600; }

  @media (prefers-reduced-motion: no-preference) {
    .hero h1, .hero-side, .door { animation: rise 600ms var(--ease-out) backwards; }
    .hero-side { animation-delay: 120ms; }
    .door:nth-child(1) { animation-delay: 200ms; }
    .door:nth-child(2) { animation-delay: 260ms; }
    .door:nth-child(3) { animation-delay: 320ms; }
    .door:nth-child(4) { animation-delay: 380ms; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }

  /* The four doors: one per part of the site, like the live site's teasers. */
  .doors {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 0.3rem + 0.6vw, 0.875rem);
  }
  .door {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    min-height: 15rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    background: var(--paper-2);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 200ms ease, transform 160ms var(--ease-out);
  }
  .door:active { transform: scale(0.98); }
  .door-n { font-weight: 600; color: var(--ink-2); font-size: var(--step-small); }
  .door-title { font-size: var(--step-1); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; text-wrap: balance; }
  .door-text { color: var(--ink-2); padding-right: 2rem; }
  .door-arrow {
    position: absolute;
    right: clamp(1.25rem, 1rem + 1vw, 2rem);
    bottom: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--blue);
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .door:hover { background: var(--blue); color: var(--paper); }
    .door:hover .door-n, .door:hover .door-text { color: var(--on-ink); }
    .door:hover .door-arrow { color: var(--paper); transform: translateX(4px); }
  }

  /* About: heading left, text right, then the four numbers in a row. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2rem var(--gutter);
    align-items: start;
  }
  .about-body { display: grid; gap: 1.5rem; }
  .statement {
    font-size: clamp(1.375rem, 1rem + 1.2vw, 2.125rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .stats {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
    margin: clamp(1.5rem, 1rem + 2vw, 3.5rem) 0 0;
  }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.5rem; }
  .stats dd {
    margin: 0;
    font-size: clamp(2.75rem, 1.5rem + 4vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: var(--blue);
  }
  .stats dt { color: var(--ink-2); }

  /* People: the names themselves are the picture. */
  .people { display: grid; gap: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .people-head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem var(--gutter);
    align-items: end;
  }
  .roster {
    margin: 0;
    padding: 0;
    list-style: none;
    columns: 3;
    column-gap: var(--gutter);
  }
  .roster a {
    display: block;
    padding-block: 0.2em;
    color: var(--ink);
    text-decoration: none;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    transition: color 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .roster a:hover { color: var(--blue); }
  }

  /* Deals: just four, on the deal field. */
  .deals-field {
    background: var(--field);
    margin-top: var(--section);
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 7rem);
  }
  .deals-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    font-weight: 600;
  }
  .deals {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.5rem, 0.3rem + 0.6vw, 0.875rem);
  }

  /* Offices. */
  .offices { display: grid; gap: 1.75rem; }
  .offices-intro { font-size: var(--step-1); line-height: 1.4; }
  .office-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem var(--gutter);
    margin: 1.5rem 0 0.5rem;
    padding: 0;
    list-style: none;
  }
  .office-list li { display: grid; gap: 0.35rem; align-content: start; }
  .office-list h3 { font-size: clamp(2rem, 1rem + 2.6vw, 3.5rem); }

  @media (max-width: 68rem) {
    .doors, .deals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 60rem) {
    .hero, .about, .people-head { grid-template-columns: 1fr; }
    .stats, .office-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .roster { columns: 2; }
  }
  @media (max-width: 34rem) {
    .doors, .deals { grid-template-columns: 1fr; }
    .door { min-height: 0; }
    .roster { columns: 1; }
    .deals :global(.tombstone) { min-height: 0; }
  }
</style>
